# Copy to .env for local use. .env is git-ignored; never commit real values.
# This file lists variable names only. No secrets belong here.

# Which AI provider to use. "mock" (deterministic, simulated) is the default.
AI_PROVIDER=

# Path of the local SQLite database file (git-ignored).
DATABASE_PATH=

# Address the development server binds to. Must stay a loopback address.
HOST=

# Port for the local development server (default 8000).
PORT=
